# Legacy 2023-2024 repos — reference only, each has its own git history.
# Excluded so they do not become broken gitlink entries in this repo.
crowdmon-nextjs/
crowdmon-video-frame-extractor/
crowdmon-extract-render/

# Agent scratch worktrees. Each is a real checkout with its own .git file, so
# `git add -A` from the repo root turns them into gitlink entries pointing at
# branches that will not exist tomorrow.
.claude/worktrees/

# Node
node_modules/
dist/
.wrangler/
*.log

# Go
worker/bin/
*.test

# Terraform — state may contain secrets, never commit
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored. It pins provider versions and
# their checksums, so a fresh clone and CI resolve the same provider build this
# machine did. Ignoring it would let `~> 5.0` drift per checkout.
# Backend config embeds the account ID
infra/backend.hcl

# Env and secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# SDD scratch: ledger, task briefs and review packages. Git history is the record.
.superpowers/

apps/web/dist
