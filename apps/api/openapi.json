{
  "openapi": "3.0.3",
  "info": {
    "version": "0.1.0",
    "title": "Crowdmon API",
    "description": "The contract between the edge Worker and the home Go worker. Generated from the zod schemas that validate requests at runtime, so the spec cannot drift from what the Worker actually accepts."
  },
  "servers": [
    {
      "url": "https://crowdmon.mkcarl.com",
      "description": "production, behind Access"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "crowdmon-api"
            ]
          },
          "environment": {
            "type": "string",
            "example": "production"
          }
        },
        "required": [
          "status",
          "service",
          "environment"
        ]
      },
      "VideoSubmission": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "job_id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 1
          }
        },
        "required": [
          "video_id",
          "job_id"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "invalid request"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "url"
          },
          "message": {
            "type": "string",
            "example": "Invalid URL"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "SubmitVideoRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
          }
        },
        "required": [
          "url"
        ]
      },
      "JobList": {
        "type": "object",
        "properties": {
          "now": {
            "type": "integer",
            "example": 1754100030
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminJob"
            }
          }
        },
        "required": [
          "now",
          "jobs"
        ]
      },
      "AdminJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 1
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "video_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "video_url": {
            "type": "string",
            "format": "uri",
            "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "claimed_by": {
            "type": "string",
            "nullable": true,
            "example": "carls-ubuntu-1"
          },
          "claimed_at": {
            "type": "integer",
            "nullable": true,
            "example": 1754100000
          },
          "heartbeat_at": {
            "type": "integer",
            "nullable": true,
            "example": 1754100030
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "example": "video unavailable"
          },
          "created_at": {
            "type": "integer",
            "example": 1754099000
          },
          "updated_at": {
            "type": "integer",
            "example": 1754100030
          },
          "chunk": {
            "$ref": "#/components/schemas/AdminChunkWork"
          }
        },
        "required": [
          "id",
          "kind",
          "video_id",
          "video_url",
          "status",
          "attempts",
          "claimed_by",
          "claimed_at",
          "heartbeat_at",
          "failure_reason",
          "created_at",
          "updated_at"
        ]
      },
      "JobKind": {
        "type": "string",
        "enum": [
          "download",
          "chunk"
        ]
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "pending",
          "claimed",
          "done",
          "failed"
        ]
      },
      "AdminChunkWork": {
        "type": "object",
        "properties": {
          "segment_index": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "end_seconds": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 60
          }
        },
        "required": [
          "segment_index",
          "start_seconds",
          "end_seconds"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 1
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "video_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "video_url": {
            "type": "string",
            "format": "uri",
            "example": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          },
          "chunk": {
            "$ref": "#/components/schemas/ChunkWork"
          }
        },
        "required": [
          "id",
          "kind",
          "video_id",
          "video_url",
          "attempts"
        ]
      },
      "ChunkWork": {
        "type": "object",
        "properties": {
          "segment_index": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          },
          "end_seconds": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 60
          }
        },
        "required": [
          "segment_index",
          "start_seconds",
          "end_seconds"
        ]
      },
      "ClaimRequest": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "minLength": 1,
            "example": "carls-ubuntu-1"
          }
        },
        "required": [
          "worker_id"
        ]
      },
      "HeartbeatRequest": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "minLength": 1,
            "example": "carls-ubuntu-1"
          }
        },
        "required": [
          "worker_id"
        ]
      },
      "CompleteRequest": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string",
            "minLength": 1,
            "example": "carls-ubuntu-1"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "failed"
            ]
          },
          "failure_reason": {
            "type": "string",
            "maxLength": 1000,
            "example": "video unavailable"
          }
        },
        "required": [
          "worker_id",
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "meta"
        ],
        "summary": "Liveness and deployment identity",
        "responses": {
          "200": {
            "description": "The Worker is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/videos": {
      "post": {
        "operationId": "submitVideo",
        "tags": [
          "admin"
        ],
        "summary": "Submit a YouTube URL for processing",
        "description": "Creates the video row and enqueues its download job. Requires a Cloudflare Access assertion in `Cf-Access-Jwt-Assertion` for an identity on the Worker's admin allowlist.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitVideoRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Video accepted and a download job enqueued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoSubmission"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body, or a URL that names no YouTube video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Access assertion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A verified identity that is not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "This video has already been submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Admin access is not configured on this deployment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/jobs": {
      "get": {
        "operationId": "listJobs",
        "tags": [
          "admin"
        ],
        "summary": "List jobs with their lease and failure state",
        "description": "The operator's view of the queue. Requires a Cloudflare Access assertion in `Cf-Access-Jwt-Assertion` for an identity on the Worker's admin allowlist.",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/JobStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "example": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Jobs, newest first, with the server's clock",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "400": {
            "description": "A malformed status or an out-of-range limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Access assertion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A verified identity that is not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Admin access is not configured on this deployment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/login": {
      "get": {
        "operationId": "adminLogin",
        "tags": [
          "admin"
        ],
        "summary": "Complete an Access login and return to the dashboard",
        "description": "Exists to be navigated to, not fetched. Access gates the path, so an unauthenticated browser is sent through the login flow and only then redirected on to `/admin`.",
        "responses": {
          "302": {
            "description": "Authenticated; redirecting to the admin dashboard",
            "headers": {
              "Location": {
                "description": "Always `/admin`",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Access assertion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A verified identity that is not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Admin access is not configured on this deployment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/claim": {
      "post": {
        "operationId": "claimJob",
        "tags": [
          "jobs"
        ],
        "summary": "Claim the next pending job",
        "description": "Atomic: the claim is a single `UPDATE ... WHERE status='pending' ... RETURNING`, so two workers polling at once cannot take the same row.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A job was claimed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "204": {
            "description": "Nothing to claim"
          },
          "400": {
            "description": "Malformed request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}/heartbeat": {
      "post": {
        "operationId": "heartbeatJob",
        "tags": [
          "jobs"
        ],
        "summary": "Renew the lease on a held job",
        "description": "Called every 30s while a job is held. Missing heartbeats are what the reaper watches for; a job whose `heartbeat_at` goes stale returns to `pending`.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "example": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Lease renewed"
          },
          "400": {
            "description": "Malformed job id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No job with this id is held by this worker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}/complete": {
      "post": {
        "operationId": "completeJob",
        "tags": [
          "jobs"
        ],
        "summary": "Report a held job as done or failed",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "example": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Outcome recorded"
          },
          "400": {
            "description": "Malformed job id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No job with this id is held by this worker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
