{
  "name": "@crowdmon/api",
  "private": true,
  "type": "module",
  "exports": {
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply crowdmon --remote",
    "db:migrate:local": "wrangler d1 migrations apply crowdmon --local",
    "db:list": "wrangler d1 migrations list crowdmon --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@microlabs/otel-cf-workers": "1.0.0-rc.52",
    "@opentelemetry/api": "^1.9.1",
    "hono": "^4.10.4",
    "jose": "^6.2.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@vitest/runner": "^4.1.10",
    "@vitest/snapshot": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.48.1"
  }
}
