# Copy to /home/carl/crowdmon/.env and fill in. Never commit the real file:
# the last two values are an Access service token.

# The custom domain, not workers.dev. Access covers this hostname; the
# worker's own endpoints sit outside that gate deliberately, but pointing at
# the ungated hostname would mean the admin surface has one layer instead of
# two for no gain.
#
# Repointed from api.crowdmon.mkcarl.com on 2026-08-03, when M5 consolidated
# everything onto one hostname. The old name is gone, so a box built from an
# unrepointed copy of this file fails every poll with no route to host.
CROWDMON_API_BASE_URL=https://crowdmon.mkcarl.com

# Attached to every span as deployment.environment.name.
CROWDMON_ENV=production

# Leave CROWDMON_WORKER_ID unset. It defaults to the hostname, which in a
# container is the short container id — unique per replica and new on every
# recreate, so a lease held by a previous incarnation can never be confused
# with this one's.

# The collector's OTLP *HTTP* traces endpoint, path included. Comment this
# out to run without tracing; setting it without the two values below is a
# startup error by design.
CROWDMON_OTLP_ENDPOINT=https://otlp.mkcarl.com/v1/traces

# Same collector, the logs path — this is what ships worker logs to Loki.
# Independently optional: comment out to keep tracing but drop logs, or vice
# versa. Either one set without the two values below is a startup error.
CROWDMON_OTLP_LOGS_ENDPOINT=https://otlp.mkcarl.com/v1/logs

# Same collector, the metrics path (M8.2) — frames.extracted, frames.kept and
# frames.dedup.ratio land here and the collector's `metrics` pipeline exports
# them to its Prometheus exporter for scraping. Independently optional like
# the logs endpoint above: comment out to keep tracing/logs but drop metrics,
# or vice versa. Set without the two values below, it is a startup error.
CROWDMON_OTLP_METRICS_ENDPOINT=https://otlp.mkcarl.com/v1/metrics

# The Access service token that gets an export past the gate in front of the
# collector. Shared by traces and logs. The policy names specific tokens, so a
# new one has to be added there before it will work (CONTEXT.md §6 runbook).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Where downloaded source videos are kept (M7.1). Defaults to
# /home/worker/videos inside the container, which docker-compose.yml backs
# with a named volume — without one, every restart would throw away videos
# whose chunk jobs have not run yet, and each of those chunks would then fail
# the affinity check (M7.4) on a box that really does have the video.
#
# Change it only together with the volume mount in docker-compose.yml. The two
# disagreeing is invisible until a restart.
# CROWDMON_WORK_DIR=/home/worker/videos

# How long a source video is kept. Source video never goes to R2 (CONTEXT.md
# §Q13) and dwarfs the frames taken from it, so nothing else bounds the disk.
# Pruning happens at the start of each download — the thing that fills the
# disk pays for the cleanup.
#
# Must stay comfortably longer than a video takes to drain its chunk jobs. A
# value with no unit ("6" rather than "6h") is a startup error rather than a
# silent six nanoseconds, which would delete every source video on the next
# prune and make a healthy box report M7.4's affinity failure everywhere.
# CROWDMON_SOURCE_TTL=6h

# Where extracted frames go (M8.3). R2's S3-compatible endpoint is
# https://<account_id>.r2.cloudflarestorage.com — the account id below, not a
# region, is what actually routes an upload to this account.
CROWDMON_R2_ACCOUNT_ID=

# The frames bucket (infra/main.tf's cloudflare_r2_bucket.frames). Defaults to
# crowdmon-frames, which is what Terraform actually names it — only override
# this for a deliberately different bucket, not to restate the default.
# CROWDMON_R2_BUCKET=crowdmon-frames

# The R2 S3-compatible API token for the frames bucket, minted by hand from
# the dashboard rather than by Terraform — see infra/README.md's "Minting the
# worker's R2 token" for why, and for the exact scope to grant (Object Read &
# Write on crowdmon-frames only, not account-wide). All three of this and the
# account id above are required together the moment any one of them is set:
# a chunk job whose upload silently no-oped because one value was missing
# would report success while writing nothing to R2.
CROWDMON_R2_ACCESS_KEY_ID=
CROWDMON_R2_SECRET_ACCESS_KEY=

# The Hamming distance below which frames.Dedup drops a frame as a
# near-duplicate of the last kept one (CONTEXT.md §Q12). Leave unset — zero
# means "let the frames package decide" (frames.DefaultDedupThreshold), and
# that default is documented once, in worker/internal/frames/frames.go,
# rather than restated here where it could drift out of sync. A value with no
# digits, or a negative one, is a startup error rather than a silent regime
# change M8.4 would then have no way to tell apart from the intended default.
# CROWDMON_DEDUP_THRESHOLD=10
